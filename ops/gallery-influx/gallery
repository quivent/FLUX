#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
import urllib.request


DEFAULT_URL = "https://gallery.influx.vision"
DEFAULT_API_URL = os.environ.get("GALLERY_API_URL", "http://127.0.0.1:7870")


def fetch(api_url: str) -> dict:
    with urllib.request.urlopen(api_url.rstrip("/") + "/api/health", timeout=20) as response:
        return json.load(response)


def fmt_time(seconds: object) -> str:
    try:
        value = float(seconds or 0)
    except (TypeError, ValueError):
        return "unknown"
    if value < 60:
        return f"{round(value)}s"
    if value < 3600:
        return f"{round(value / 60)}m"
    return f"{value / 3600:.1f}h"


def status(args: argparse.Namespace) -> int:
    data = fetch(args.api_url)
    print(args.url.rstrip("/") + "/gallery")
    for name in ("flux", "wan"):
        health = data["health"][name]
        counts = health.get("counts", {})
        print(
            f"{name.upper()} ok={health.get('ok')} "
            f"running={counts.get('running', 0)} queued={counts.get('queued', 0)} "
            f"done={counts.get('done', 0)} failed={(counts.get('failed', 0) + counts.get('error', 0))}"
        )
    return 0


def health(args: argparse.Namespace) -> int:
    data = fetch(args.api_url)
    if args.json:
        print(json.dumps(data["health"], indent=2, sort_keys=True))
        return 0
    return status(args)


def pipeline(args: argparse.Namespace) -> int:
    data = fetch(args.api_url)
    kinds = [args.kind] if args.kind != "all" else ["flux", "wan"]
    for kind in kinds:
        rows = data.get(kind, {}).get("pipeline", [])
        print(f"{kind.upper()} pipeline")
        if not rows:
            print("  no queued or running jobs")
            continue
        for row in rows:
            state = row.get("state", "")
            eta = fmt_time(row.get("eta_seconds"))
            prompt = str(row.get("prompt") or "")[:100]
            print(
                f"  #{row.get('position')} {row.get('id')} {state} "
                f"{row.get('task', '')} {row.get('size', '')} eta={eta} {prompt}"
            )
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(prog="gallery", description="Public FLUX/WAN gallery control")
    parser.add_argument("--url", default=DEFAULT_URL)
    parser.add_argument("--api-url", default=DEFAULT_API_URL)
    sub = parser.add_subparsers(dest="command")
    p_status = sub.add_parser("status")
    p_status.set_defaults(func=status)
    p_health = sub.add_parser("health")
    p_health.add_argument("--json", action="store_true")
    p_health.set_defaults(func=health)
    p_pipeline = sub.add_parser("pipeline")
    p_pipeline.add_argument("kind", nargs="?", choices=["all", "flux", "wan"], default="all")
    p_pipeline.set_defaults(func=pipeline)
    args = parser.parse_args(argv)
    if not args.command:
        args.func = status
    return args.func(args)


if __name__ == "__main__":
    raise SystemExit(main())
